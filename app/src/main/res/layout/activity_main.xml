<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="28dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_title"
                    android:textColor="@color/ink"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_subtitle"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/SectionTitle"
            android:text="@string/preview_title" />

        <FrameLayout
            android:id="@+id/preview_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="200dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

        <TextView
            style="@style/SectionTitle"
            android:layout_marginTop="14dp"
            android:text="@string/preview_small_title" />

        <FrameLayout
            android:id="@+id/preview_small_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="120dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/google_title"
                android:textColor="@color/ink"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/account_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/muted"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/sync_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/faint"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/error_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/coral"
                android:textSize="13sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/connect_button"
                style="@style/PlannerButton"
                android:background="@drawable/button_primary"
                android:text="@string/connect_google"
                android:textColor="@color/accent_ink"
                android:textStyle="bold" />

            <Button
                android:id="@+id/switch_account"
                style="@style/PlannerButton"
                android:text="@string/switch_account" />

            <Button
                android:id="@+id/disconnect"
                style="@style/PlannerButton"
                android:text="@string/disconnect"
                android:textColor="@color/coral" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/calendar_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/calendars_title"
                    android:textColor="@color/ink"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/select_all"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/select_all"
                    android:textColor="@color/accent"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/calendar_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/calendar_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <Button
            android:id="@+id/pin_widget"
            style="@style/PlannerButton"
            android:layout_marginTop="18dp"
            android:background="@drawable/button_primary"
            android:text="@string/pin_widget"
            android:textColor="@color/accent_ink"
            android:textStyle="bold" />

        <Button
            android:id="@+id/pin_widget_small"
            style="@style/PlannerButton"
            android:text="@string/pin_widget_small" />

        <Button
            android:id="@+id/refresh_now"
            style="@style/PlannerButton"
            android:text="@string/refresh_now" />

        <Button
            android:id="@+id/open_site"
            style="@style/PlannerButton"
            android:text="@string/open_site" />

        <Button
            android:id="@+id/done"
            style="@style/PlannerButton"
            android:text="@string/done"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/howto"
            android:textColor="@color/faint"
            android:textSize="13sp" />

        <TextView
            style="@style/SectionTitle"
            android:text="@string/app_info_title" />

        <TextView
            android:id="@+id/signing_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:fontFamily="monospace"
            android:lineSpacingExtra="4dp"
            android:padding="16dp"
            android:textColor="@color/muted"
            android:textIsSelectable="true"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
